{
  "expo": {
    "name": "MealPulse AI: AI Calorie Counter",
    "slug": "mealpulse-ai",
    "version": "2.3.3",
    "orientation": "portrait",
    "icon": "./assets/icona_nuova.png",
    "scheme": "mealpulse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealpulse.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "MealPulse AI accesses your active energy burned and steps to accurately calculate your daily calorie deficit and remaining nutrition budget.",
        "NSHealthUpdateUsageDescription": "MealPulse AI updates your nutrition and calorie data to keep your health records synchronized.",
        "NSMicrophoneUsageDescription": "MealPulse AI uses the microphone to record your spoken meal descriptions and automatically calculate nutrition with Gemini AI."
      }
    },
    "android": {
      "package": "com.mealpulse.app",
      "versionCode": 101,
      "adaptiveIcon": {
        "backgroundColor": "#BEF264",
        "foregroundImage": "./assets/icona_nuova.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3077938552594114~7408470274",
          "android_app_id": "ca-app-pub-3077938552594114~7408470274"
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8acb6f1f-3486-4296-bbaf-f1734b7bd4b6"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3077938552594114~7408470274"
  }
}
